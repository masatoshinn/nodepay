# ---- server ----
NODE_ENV=development
PORT=4000
# Option 1 — Supabase (hosted Postgres):
#   Dashboard → Project → Settings → Database → Connection string → URI
#   (mode: Transaction pooler, port 6543) — keep ?sslmode=require
#   postgresql://postgres.abcdefg:password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require
# Option 2 — local Postgres (docker compose --profile localdb up -d postgres):
DATABASE_URL=postgresql://nodepay:nodepay@localhost:5432/nodepay
REDIS_URL=redis://localhost:6379

# auth
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-another-long-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# AES-256-GCM key (64 hex chars = 32 bytes) for webhook secrets & TOTP seeds
# generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# urls / cors
APP_URL=http://localhost:5173
API_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# explorer providers (swap base urls to use other vendors)
ETHERSCAN_API_KEY=
ETHERSCAN_API_BASE=https://api.etherscan.io/v2/api
ETHERSCAN_CHAIN_ID=1
BSCSCAN_API_KEY=
BSCSCAN_API_BASE=https://api.bscscan.com/api
TRONGRID_API_KEY=
TRONGRID_API_BASE=https://api.trongrid.io
MEMPOOL_SPACE_URL=https://mempool.space/api
LITECOIN_API_BASE=https://litecoinspace.org/api
COINGECKO_API_BASE=https://api.coingecko.com/api/v3

# invoices / workers
INVOICE_TTL_MINUTES=30
SCAN_INTERVAL_MS=15000
BTC_SCAN_INTERVAL_MS=60000

# platform fee (non-custodial accrual)
FREE_PLAN_FEE_BPS=100
PRO_PLAN_FEE_BPS=0

# seeding
ADMIN_EMAIL=admin@nodepay.local
ADMIN_PASSWORD=
DEMO_MERCHANT_EMAIL=
DEMO_MERCHANT_PASSWORD=

# set true only for local webhook testing against localhost
ALLOW_PRIVATE_WEBHOOKS=false

# ---- client ----
VITE_API_URL=http://localhost:4000
