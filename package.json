{
  "name": "nodepay",
  "version": "0.1.0",
  "private": true,
  "description": "NodePay — non-custodial crypto payment gateway",
  "scripts": {
    "dev:server": "npm run dev --prefix server",
    "dev:worker": "npm run worker --prefix server",
    "dev:client": "npm run dev --prefix client",
    "build": "npm run build --prefix server && npm run build --prefix client",
    "typecheck": "npm run typecheck --prefix server && npm run typecheck --prefix client",
    "db:migrate": "npm run db:migrate --prefix server",
    "db:push": "npm run db:push --prefix server",
    "db:seed": "npm run db:seed --prefix server",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down"
  }
}
